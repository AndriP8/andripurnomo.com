---
import Dots from "./Dots.astro";
import { formatDate } from "@lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  blog: CollectionEntry<"blog">;
}

const { blog } = Astro.props;
---

<a href={`/blog/${blog.id}`} class="wrapper-link-blog">
  <div>
    <img
      src={`/images/blogs/${blog.id}/cover/resource.jpg`}
      alt={blog.data.cover.alt}
      class="w-full h-[450px] object-cover rounded-xl"
      width={350}
      height={450}
      loading="eager"
    />
  </div>
  <div class="my-4">
    <div class="flex items-center justify-start gap-x-2 text-gray-500">
      <p>{formatDate(blog.data.createdAt)}</p>
      <Dots bgColor="bg-gray-500" />
      <p>{blog.data.timeToRead} min read</p>
    </div>
    <p class="text-2xl font-medium">{blog.data.title}</p>
  </div>
</a>
