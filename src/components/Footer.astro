---
const yearNow = new Date().getFullYear();
---

<footer
  id="contact"
  class="border-t-4 border-black pt-12 max-w-5xl mx-auto px-4 md:px-8 pb-12"
>
  <div class="grid md:grid-cols-2 gap-12">
    <div class="bg-black text-white p-8 shadow-[-8px_-8px_0px_0px_rgba(150,150,150,1)]">
      <h2 class="text-5xl font-sans font-bold mb-6 uppercase">
        Let's
        <br />
        Build.
      </h2>
      <p class="mb-8 font-mono text-sm">Open to exploring new opportunities.</p>
      <a
        href="mailto:andri.adrp@gmail.com"
        class="inline-block bg-white text-black border-2 border-transparent hover:border-white hover:bg-black hover:text-white px-6 py-3 font-bold transition-all w-full text-center"
      >
        SEND EMAIL -&gt;
      </a>
    </div>

    <div class="flex flex-col justify-between">
      <div class="grid grid-cols-2 gap-4">
        <a
          href="https://twitter.com/Andrii_purnomo"
          target="_blank"
          rel="noreferrer noopener"
          class="border-2 border-black p-4 font-bold hover:bg-black hover:text-white transition-colors text-center shadow-hard-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px]"
        >
          TWITTER
        </a>
        <a
          href="https://github.com/andrip8/"
          target="_blank"
          rel="noreferrer noopener"
          class="border-2 border-black p-4 font-bold hover:bg-black hover:text-white transition-colors text-center shadow-hard-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px]"
        >
          GITHUB
        </a>
        <a
          href="https://www.linkedin.com/in/andri-purnomo/"
          target="_blank"
          rel="noreferrer noopener"
          class="col-span-2 border-2 border-black p-4 font-bold hover:bg-black hover:text-white transition-colors text-center shadow-hard-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px]"
        >
          LINKEDIN
        </a>
      </div>
      <div class="mt-8 text-right font-mono text-xs">
        <p>COPYRIGHT © {yearNow}</p>
        <p>ANDRI PURNOMO</p>
      </div>
    </div>
  </div>
</footer>
